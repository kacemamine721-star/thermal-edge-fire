# ==============================================================
# Thermal-Edge-Fire  —  .gitignore
# CubeSat wildfire detection pipeline (Dual-Gate Architecture)
# ==============================================================

# ── Data (large satellite imagery — NEVER commit) ─────────────
data/raw/
data/external/
data/interim/
data/processed/
*.tif
*.tiff
*.hdf5
*.h5
*.nc
*.npy
*.npz
*.zarr

# ── Figures, Reports & Benchmarks Whitelist ───────────────────
!reports/figures/
!reports/figures/*
!reports/*.md
!reports/*.csv
!reports/model_benchmarks/
!reports/model_benchmarks/*
!reports/.gitkeep

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
*.so

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
!notebooks/*.ipynb

# ── Testing & coverage ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── IDE / Editors ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ── OS artefacts ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Logs, databases & temporary files ─────────────────────────
*.log
*.tmp
*.bak
*.orig
*.db
*.sqlite
*.sqlite3

# ── Model artifacts (raw/intermediate weights) ────────────────
models/
checkpoints/
epoch_checkpoints/
*.pt
*.pth
*.onnx
*.tflite

# ── Misc archives ─────────────────────────────────────────────
.env
*.zip
*.tar.gz
*.7z

# ── Whitelist Standalone Web Demo Assets for Deployment ────────
!demo/models/
!demo/models/*
!demo/models/**
!demo/sample_data/
!demo/sample_data/*
!demo/sample_data/**
demo/sample_data/custom_tif/*.tif
demo/full_scene_outputs/
