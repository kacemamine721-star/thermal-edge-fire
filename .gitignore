# ==============================================================
# Thermal-Edge-Fire  —  .gitignore
# CubeSat wildfire detection pipeline (Dual-Gate Architecture)
# ==============================================================

# ── Data (large satellite imagery — NEVER commit) ─────────────
data/raw/
data/external/
data/interim/
data/processed/
*.tif
*.tiff
*.hdf5
*.h5
*.nc
*.npy
*.npz
*.zarr

# ── Generated reports & figures (reproducible from scripts) ───
reports/figures/
reports/*.csv
!reports/.gitkeep

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
*.so

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing & coverage ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── IDE / Editors ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ── OS artefacts ──────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Logs & temporary files ────────────────────────────────────
*.log
*.tmp
*.bak
*.orig

# ── Model artifacts (trained weights — will come later) ───────
models/
checkpoints/
*.pt
*.pth
*.onnx
*.tflite

# ── Misc ──────────────────────────────────────────────────────
.env
*.zip
*.tar.gz
*.7z
